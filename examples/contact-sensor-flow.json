[
    {
        "id": "example-flow",
        "type": "tab",
        "label": "Matter Contact Sensor Example",
        "disabled": false,
        "info": "Example flow showing how to monitor a Matter door/contact sensor"
    },
    {
        "id": "matter-controller-example",
        "type": "matter-controller",
        "name": "My Matter Controller"
    },
    {
        "id": "contact-sensor-1",
        "type": "matter-device",
        "z": "example-flow",
        "name": "Front Door Sensor",
        "controller": "matter-controller-example",
        "device": "",
        "deviceType": "contact",
        "outputOnChange": true,
        "pollInterval": 0,
        "x": 180,
        "y": 140,
        "wires": [
            ["debug-raw", "check-open", "check-closed"]
        ]
    },
    {
        "id": "debug-raw",
        "type": "debug",
        "z": "example-flow",
        "name": "Raw Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "x": 430,
        "y": 80,
        "wires": []
    },
    {
        "id": "check-open",
        "type": "switch",
        "z": "example-flow",
        "name": "Check if Open",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "open",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 430,
        "y": 140,
        "wires": [
            ["notify-open"]
        ]
    },
    {
        "id": "notify-open",
        "type": "debug",
        "z": "example-flow",
        "name": "🚪 Door Opened!",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 650,
        "y": 140,
        "wires": []
    },
    {
        "id": "check-closed",
        "type": "switch",
        "z": "example-flow",
        "name": "Check if Closed",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "closed",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 430,
        "y": 200,
        "wires": [
            ["notify-closed"]
        ]
    },
    {
        "id": "notify-closed",
        "type": "debug",
        "z": "example-flow",
        "name": "🔒 Door Closed",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 650,
        "y": 200,
        "wires": []
    },
    {
        "id": "manual-trigger",
        "type": "inject",
        "z": "example-flow",
        "name": "Manual Read",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 180,
        "y": 80,
        "wires": [
            ["contact-sensor-1"]
        ]
    },
    {
        "id": "comment-1",
        "type": "comment",
        "z": "example-flow",
        "name": "Click 'Manual Read' to trigger an immediate state check, or let the sensor report changes automatically",
        "info": "",
        "x": 380,
        "y": 40,
        "wires": []
    },
    {
        "id": "comment-2",
        "type": "comment",
        "z": "example-flow",
        "name": "Configure the Matter Controller first (double-click to commission your device)",
        "info": "",
        "x": 340,
        "y": 280,
        "wires": []
    }
]

