{
  "name": "node-red-contrib-matter",
  "version": "1.0.0",
  "description": "Node-RED nodes for Matter device integration",
  "main": "nodes/matter-controller.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:e2e": "jest test/e2e",
    "lint": "eslint lib/ nodes/ test/",
    "lint:fix": "eslint lib/ nodes/ test/ --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "nodes/*.js",
      "!**/node_modules/**",
      "!**/test/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "**/test/**/*.spec.js",
      "**/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": ["<rootDir>/test/setup.js"],
    "moduleNameMapping": {
      "^@project-chip/matter-node.js$": "<rootDir>/test/helpers/mock-matter.js",
      "^@project-chip/matter-node.js/schema$": "<rootDir>/test/helpers/mock-schema.js",
      "^@project-chip/matter-node.js/storage$": "<rootDir>/test/helpers/mock-storage.js",
      "^@project-chip/matter.js/cluster$": "<rootDir>/test/helpers/mock-cluster.js"
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^14.0.0",
    "eslint-plugin-promise": "^6.1.1"
  },
  "dependencies": {
    "@project-chip/matter-node.js": "^0.9.0",
    "@project-chip/matter.js": "^0.9.0"
  },
  "keywords": [
    "node-red",
    "matter",
    "iot",
    "smart-home",
    "thread",
    "wifi"
  ],
  "author": "Your Name",
  "license": "MIT",
  "node-red": {
    "nodes": {
      "matter-controller": "nodes/matter-controller.js",
      "matter-device": "nodes/matter-device.js"
    }
  }
}